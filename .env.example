# Sao chép thành .env (KHÔNG commit file .env lên GitHub)
# Bỏ trống ANTHROPIC_API_KEY -> pipeline tự dùng bản tin template
ANTHROPIC_API_KEY=
# on | off
LLM_MODE=on
# Tab "Hỏi dữ liệu" (Hỏi tài liệu - RAG, Hỏi số liệu - SQL) dùng Gemini - lấy key tại aistudio.google.com
GEMINI_API_KEY=
# on | off
GEMINI_MODE=on
# Tùy chọn: gửi tóm tắt tuần qua Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Tùy chọn: gửi email báo cáo cho từng phòng ban (vd. Gmail: smtp.gmail.com + App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Link dashboard đã deploy (Streamlit Community Cloud) để chèn vào email
DASHBOARD_URL=
